+static int
+asn1print_bitstring_named_default(asn1p_t *asn,
+        asn1p_expr_t *component,
+        const asn1p_value_t *value,
+        enum asn1print_flags flags) {
+    asn1p_expr_t *type;
+    asn1p_expr_t *bit;
+    int first = 1;
+
+    if(!component || !component->module
+    || !value || value->type != ATV_BITVECTOR) {
+        return asn1print_value(value, flags);
+    }
+
+    type = WITH_MODULE_NAMESPACE(
+        component->module, expr_ns,
+        asn1f_find_terminal_type_ex(asn, expr_ns, component));
+
+    if(!type || type->expr_type != ASN_BASIC_BIT_STRING)
+        return asn1print_value(value, flags);
+
+    safe_printf("{");
+
+    TQ_FOR(bit, &(type->members), next) {
+        asn1c_integer_t bit_position;
+
+        if(!bit->Identifier
+        || !bit->value
+        || bit->value->type != ATV_INTEGER)
+            continue;
+
+        bit_position = bit->value->value.v_integer;
+
+        if(bit_position < 0
+        || bit_position >= value->value.binary_vector.size_in_bits)
+            continue;
+
+        if(!(value->value.binary_vector.bits[bit_position >> 3]
+             & (0x80u >> (bit_position & 7))))
+            continue;
+
+        if(!first)
+            safe_printf(", ");
+
+        safe_printf("%s", bit->Identifier);
+        first = 0;
+    }
+
+    safe_printf("}");
+    return 0;
 }
 

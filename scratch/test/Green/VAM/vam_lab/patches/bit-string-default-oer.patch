+static int
+default_bitstring_size_in_bits(asn1p_expr_t *expr,
+                               asn1p_expr_type_e etype) {
+    asn1cnst_range_t *range;
+    int bits = expr->marker.default_value->value.binary_vector.size_in_bits;
+
+    if(!(expr->_mark & TM_BS_DEFAULT_NAMED)
+    || bits < 0 || bits > INT_MAX - 7
+    || !expr->combined_constraints)
+        return bits;
+
+    range = asn1constraint_compute_constraint_range(
+        expr->Identifier, etype, expr->combined_constraints,
+        ACT_CT_SIZE, 0, 0, 0
+    );
+
+    if(range) {
+        if(!range->incompatible
+        && !range->empty_constraint
+        && !range->extensible
+        && range->el_count == 0
+        && range->left.type == ARE_VALUE
+        && range->right.type == ARE_VALUE
+        && range->left.value == range->right.value
+        && range->left.value >= (asn1c_integer_t)bits
+        && range->left.value <= (asn1c_integer_t)(INT_MAX - 7)) {
+            bits = (int)range->left.value;
+        }
+
+        asn1constraint_range_free(range);
+    }
+
+    return bits;
